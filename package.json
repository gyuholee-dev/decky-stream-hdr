{
  "name": "decky-stream-hdr",
  "version": "1.0.0",
  "description": "Decky plugin that enables real HDR for Steam Remote Play on Linux clients",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -t ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyuholee-dev/decky-stream-hdr.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam",
    "remote-play",
    "hdr"
  ],
  "author": "GyuhoLee",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
