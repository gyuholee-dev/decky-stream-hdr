{
  "name": "decky-stream-hdr",
  "version": "1.0.0",
  "description": "Decky plugin that enables real HDR for Steam Remote Play on Linux clients",
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "serve": "webpack serve --config webpack.serve.config.js",
    "start": "webpack serve --config webpack.serve.config.js --open",
    "capture": "node scripts/capture-steam-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -t ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyuholee-dev/decky-stream-hdr.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam",
    "remote-play",
    "hdr"
  ],
  "author": "GyuhoLee",
  "license": "MIT",
  "devDependencies": {
    "@decky/ui": "^4.11.0",
    "@material-design-icons/svg": "^0.14.15",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  }
}
